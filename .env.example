NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CLIENT_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messora?schema=public
# Background jobs (npm run worker)
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Requests per 15 min per IP on login/register/OTP routes (raise locally for e2e tests)
AUTH_RATE_LIMIT=20

# In production with client & server on different domains use COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Brevo (leave BREVO_API_KEY empty in development to print emails to the console)
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@messora.app
MAIL_FROM_NAME=Messora
